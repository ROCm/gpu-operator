ARG DTK_AUTO

FROM ${DTK_AUTO} as builder
ARG KERNEL_VERSION
ARG DRIVERS_VERSION
ARG REPO_URL
ARG GIM_RELEASE_TAG
ARG GIM_RPM_PACKAGE
RUN wget -q https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm \
      -O /tmp/epel-release.rpm && \
    rpm -Uvh /tmp/epel-release.rpm && \
    rm -f /tmp/epel-release.rpm && \
    crb enable && \
    sed -i "s/\$releasever/9/g" /etc/yum.repos.d/epel*.repo && \
    dnf install dnf-plugin-config-manager -y && \
    dnf clean all

RUN printf '%s\n' \
      '[centos-stream-baseos]' \
      'name=CentOS Stream 9 - BaseOS' \
      'baseurl=https://mirror.stream.centos.org/9-stream/BaseOS/x86_64/os/' \
      'enabled=1' \
      'gpgcheck=1' \
      'gpgkey=https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official' \
      > /etc/yum.repos.d/centos-stream.repo && \
    printf '%s\n' \
      '[centos-stream-appstream]' \
      'name=CentOS Stream 9 - AppStream' \
      'baseurl=https://mirror.stream.centos.org/9-stream/AppStream/x86_64/os/' \
      'enabled=1' \
      'gpgcheck=1' \
      'gpgkey=https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official' \
      >> /etc/yum.repos.d/centos-stream.repo && \
    rpm --import https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official && \
    dnf clean all

RUN dnf install automake bc cmake dkms -y && \
    wget https://github.com/amd/MxGPU-Virtualization/releases/download/${GIM_RELEASE_TAG}/${GIM_RPM_PACKAGE} && \
    rpm -Uvh ./${GIM_RPM_PACKAGE} && \
    dnf clean all && \
    rm ./${GIM_RPM_PACKAGE} && \
    depmod ${KERNEL_VERSION} && \
    find /lib/modules/${KERNEL_VERSION} -name "*.ko.xz" -exec xz -d {} \; && \
    depmod ${KERNEL_VERSION}

RUN mkdir -p /modules_files && \
    mkdir -p /gim_ko_files && \
    mkdir -p /kernel_files && \
    cp /lib/modules/${KERNEL_VERSION}/modules.* /modules_files/ && \
    cp -r /lib/modules/${KERNEL_VERSION}/extra/* /gim_ko_files/ && \
    cp -r /lib/modules/${KERNEL_VERSION}/kernel/* /kernel_files/

FROM registry.redhat.io/ubi9/ubi-minimal:9.8

ARG KERNEL_VERSION

RUN microdnf install -y kmod

COPY --from=builder /gim_ko_files /opt/lib/modules/${KERNEL_VERSION}/extra
COPY --from=builder /kernel_files /opt/lib/modules/${KERNEL_VERSION}/kernel
COPY --from=builder /modules_files /opt/lib/modules/${KERNEL_VERSION}/
