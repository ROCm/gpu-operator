FROM $$BASEIMG_REGISTRY/ubuntu:$$VERSION AS builder

ARG KERNEL_FULL_VERSION

ARG DRIVERS_VERSION

ARG REPO_URL

ARG GIM_RELEASE_TAG

ARG GIM_DEB_PACKAGE

RUN apt-get update && \
    apt-get install -y build-essential \
    dkms \
    autoconf \
    automake \
    wget \
    bc \
    linux-headers-${KERNEL_FULL_VERSION} \
    linux-modules-extra-${KERNEL_FULL_VERSION} && \
    apt-get clean

RUN wget https://github.com/amd/MxGPU-Virtualization/releases/download/${GIM_RELEASE_TAG}/${GIM_DEB_PACKAGE} && \
    apt-get install --fix-broken -y ./${GIM_DEB_PACKAGE} && \
    rm ${GIM_DEB_PACKAGE}

RUN depmod ${KERNEL_FULL_VERSION}

FROM $$BASEIMG_REGISTRY/ubuntu:$$VERSION

ARG KERNEL_FULL_VERSION

RUN apt-get update && apt-get install -y kmod
RUN mkdir -p /opt/lib/modules/${KERNEL_FULL_VERSION}/updates/dkms/
COPY --from=builder /lib/modules/${KERNEL_FULL_VERSION}/updates/dkms/gim* /opt/lib/modules/${KERNEL_FULL_VERSION}/updates/dkms/
COPY --from=builder /lib/modules/${KERNEL_FULL_VERSION}/modules.* /opt/lib/modules/${KERNEL_FULL_VERSION}/
